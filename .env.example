# Optional: copy to .env to override the defaults. Nothing here is required.

# Site under test
BASE_URL=https://www.amtrak.com

# Parallel browsers. Kept low: this suite runs against a live site with bot protection.
WORKERS=2

# Browser timezone. The date picker uses the browser clock, so it's pinned for repeatable runs.
TIMEZONE=America/New_York

# Use an installed browser instead of Playwright's bundled Chromium, e.g. chrome.
# Try this first if the site blocks the bundled browser.
BROWSER_CHANNEL=
